# Build / push (copy to .env.local; gitignored)
DOCKERHUB_USERNAME=shurikan117
DOCKERHUB_TOKEN=your-dockerhub-token
MIN_FREE_GIB=25

# Runtime defaults (TAO-Umbrel / docker-compose.yml) — override on your host as needed
UMBREL_IMAGE=shurikan117/tao-umbrel:1.7.3
UMBREL_DATA_HOST=./umbrel
UMBREL_HTTP_PORT=80

# Examples (Unraid, etc.):
# UMBREL_DATA_HOST=/mnt/user/appdata/umbrel
# UMBREL_HTTP_PORT=8088

# Minimal docker run (after: set -a && source .env.local && set +a)
# docker pull "${UMBREL_IMAGE}"
# docker run -d --name umbrel --pid host --restart always --stop-timeout 60 \
#   -p "${UMBREL_HTTP_PORT}:80" \
#   -v "${UMBREL_DATA_HOST}:/data" \
#   -v /var/run/docker.sock:/var/run/docker.sock \
#   "${UMBREL_IMAGE}"

# Compose: export the same vars or use a project .env file, then docker compose pull && docker compose up -d
# Kopia: add -v "${UMBREL_DATA_HOST}/kopia:/kopia" to docker run, or use docker-compose.override.example.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.full-host.example.yml
