DOCKERHUB_USERNAME=shurikan117
DOCKERHUB_TOKEN=your-dockerhub-token
UMBREL_IMAGE=shurikan117/tao-umbrel:1.7.3
UMBREL_DATA_HOST=./umbrel
UMBREL_HTTP_PORT=80
# host = mount NAS on the host first (recommended for Unraid / shared Docker)
# container = umbreld mounts CIFS (add cap_add: SYS_ADMIN in your compose/run)
# auto = host inside Docker, container on bare metal
UMBREL_NETWORK_STORAGE_MODE=host
# umbreld log level: silent | normal | verbose (verbose floods logs with WS rpc lines)
UMBREL_LOG_LEVEL=normal
MIN_FREE_GIB=25
