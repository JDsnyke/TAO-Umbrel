DOCKERHUB_USERNAME=shurikan117
DOCKERHUB_TOKEN=your-dockerhub-token
UMBREL_IMAGE=shurikan117/tao-umbrel:1.7.3
MIN_FREE_GIB=25

# --- docker compose / docker run (set in shell or Unraid "Extra Parameters" style exports) ---
# UMBREL_HTTP_PORT=8088
# UMBREL_DATA_HOST=/mnt/user/appdata/umbrel
# Minimal `docker run` (after export or copy values):
# docker run -d --name umbrel --pid host --restart always --stop-timeout 60 \
#   -p "${UMBREL_HTTP_PORT:-80}:80" -v "${UMBREL_DATA_HOST:-./umbrel}:/data" \
#   -v /var/run/docker.sock:/var/run/docker.sock "${UMBREL_IMAGE:-shurikan117/tao-umbrel:1.7.3}"
# Kopia: add -v "${UMBREL_DATA_HOST}/kopia:/kopia" if that directory exists on the host.
# Merge multiple Compose files without using docker-compose.override.yml:
# COMPOSE_FILE=docker-compose.yml:docker-compose.full-host.example.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
